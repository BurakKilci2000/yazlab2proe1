# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore içindedir; anahtarlar asla koda yazılmaz.

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kocaeli_haber

# Sunucu tarafı: Geocoding API (IP kısıtlaması önerilir)
GOOGLE_GEOCODING_API_KEY=

# Tarayıcı tarafı: Maps JavaScript API (HTTP referrer kısıtlaması zorunlu tutun)
GOOGLE_MAPS_JS_API_KEY=
# Boş bırakılırsa Google'ın DEMO_MAP_ID değeri kullanılır
GOOGLE_MAPS_MAP_ID=

# Servis seçimi: auto (varsayılan) = Google anahtarı varsa Google, yoksa OpenStreetMap.
# Açıkça seçmek için: GEOCODER=google | nominatim   MAP_PROVIDER=google | osm
# Not: Proje dokümanı harita için Google Maps istiyor; "osm" yalnızca geçici.
GEOCODER=auto
MAP_PROVIDER=auto
# Nominatim kullanım kuralları gereği kendinizi tanıtın (önerilir)
NOMINATIM_EMAIL=

SCRAPE_DAYS=3
SCRAPE_INTERVAL_MINUTES=60
SCRAPE_ON_STARTUP=1
SIMILARITY_THRESHOLD=0.90
